# Vision provider: gemini | dummy
VISION_PROVIDER=dummy

# Required when VISION_PROVIDER=gemini
GEMINI_API_KEY=

# Intent classification: keyword | gemini
# keyword = fast, offline, no API key needed
# gemini  = smarter, handles complex queries, requires GEMINI_API_KEY
INTENT_PROVIDER=keyword

# Memory store settings
MAX_ENTRIES=100

# Comma-separated list of objects to always keep in memory (never pruned)
# Defaults: wallet, keys, phone, glasses, medication, cane
PINNED_OBJECTS=wallet,keys,phone,glasses
